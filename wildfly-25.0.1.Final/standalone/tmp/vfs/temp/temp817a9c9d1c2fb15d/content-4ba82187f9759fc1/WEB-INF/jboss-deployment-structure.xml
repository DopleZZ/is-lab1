<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure>
    <deployment>
        <exclusions>
            <!-- Исключаем JSF модули -->
            <module name="com.sun.jsf-impl"/>
            <module name="javax.faces.api"/>
            <module name="org.jboss.as.jsf"/>
        </exclusions>
        <exclude-subsystems>
            <subsystem name="jsf"/>
        </exclude-subsystems>
    </deployment>
</jboss-deployment-structure>

